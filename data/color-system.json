      "offwhite-oracao",
      "preto-presenca",
      "areia-serena"
    ],
    "doNotCreateLogoColorVariants": true,
    "doNotUseDouradoAsMetallicByDefault": true,
    "requireSupplierValidationBeforeProduction": true
  }
}
